# TeachOnce Phase 0 — copy to .env and fill. Never commit .env.

# Local dummy key for self-hosted vLLM (must match vLLM --api-key)
LOCAL_VLLM_API_KEY=teachonce-local-key

# OpenAI-compatible base URL (on Brev VM = loopback; on Mac = SSH tunnel)
NVIDIA_VLLM_BASE_URL=http://127.0.0.1:8000/v1

# Exact model id from GET /v1/models
# SFT (app): nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-BF16-SFT  (scripts/start_vllm_sft.sh)
# Smoke:     Qwen/Qwen2.5-1.5B-Instruct
MODEL_ID=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-BF16-SFT

# vLLM bind (Mac tunnel → VM loopback)
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_GPU_MEMORY_UTILIZATION=0.6
VLLM_MAX_MODEL_LEN=4096

# Paths on the Brev VM (adjust after provision)
BREV_INSTANCE_NAME=teachonce-gpu
VLLM_VENV=~/teachonce/vllm-nemotron-env
SFT_MERGED=/data/merged-nemotron-sft
SFT_SERVED_NAME=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-BF16-SFT
GYM_DIR=~/teachonce
GYM_VENV=~/teachonce/gym-venv

# GRPO smoke (W&B live metrics in notebook)
# Hackathon Forge: https://forge.coreweave.com (or https://wandb.ai/authorize)
WANDB_API_KEY=
WANDB_BASE_URL=https://api.forge.coreweave.com
WANDB_PROJECT=teachonce-nemo-rl
WANDB_NAME=grpo-smoke-10
WANDB_ENTITY=
WANDB_RUN_PATH=
