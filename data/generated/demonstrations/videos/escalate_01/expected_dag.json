{
  "id": "WF-escalate_01",
  "name": "severity_escalation (p1)",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "a0_get_ticket",
      "type": "ACTION",
      "label": "Get Ticket",
      "tool": "crm",
      "op": "GET_TICKET",
      "inputs": {
        "ticket_id": {
          "ref": "$case.ticket_id"
        }
      }
    },
    {
      "id": "a1_lookup_customer",
      "type": "ACTION",
      "label": "Lookup Customer",
      "tool": "crm",
      "op": "LOOKUP_CUSTOMER",
      "inputs": {
        "query": {
          "ref": "$case.query"
        }
      }
    },
    {
      "id": "a2_assess_severity",
      "type": "ACTION",
      "label": "Assess Severity",
      "tool": "crm",
      "op": "ASSESS_SEVERITY",
      "inputs": {
        "ticket_id": {
          "ref": "$case.ticket_id"
        }
      }
    },
    {
      "id": "a3_update_ticket",
      "type": "ACTION",
      "label": "Update Ticket",
      "tool": "crm",
      "op": "UPDATE_TICKET",
      "inputs": {
        "ticket_id": {
          "ref": "$case.ticket_id"
        }
      }
    },
    {
      "id": "decide_severity",
      "type": "DECISION",
      "label": "Severity",
      "branches": [
        {
          "name": "P1"
        },
        {
          "name": "Standard"
        }
      ]
    },
    {
      "id": "branch_p1",
      "type": "ACTION",
      "label": "Page Oncall",
      "tool": "crm",
      "op": "PAGE_ONCALL",
      "inputs": {
        "ticket_id": {
          "ref": "$case.ticket_id"
        }
      }
    },
    {
      "id": "end_p1",
      "type": "END",
      "outcome": "SUCCEEDED"
    },
    {
      "id": "branch_standard",
      "type": "ACTION",
      "label": "Assign L2 Queue",
      "tool": "crm",
      "op": "ASSIGN_L2_QUEUE",
      "inputs": {
        "ticket_id": {
          "ref": "$case.ticket_id"
        }
      }
    },
    {
      "id": "end_standard",
      "type": "END",
      "outcome": "SUCCEEDED"
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "a0_get_ticket",
      "when": null
    },
    {
      "from": "a0_get_ticket",
      "to": "a1_lookup_customer",
      "when": null
    },
    {
      "from": "a1_lookup_customer",
      "to": "a2_assess_severity",
      "when": null
    },
    {
      "from": "a2_assess_severity",
      "to": "a3_update_ticket",
      "when": null
    },
    {
      "from": "a3_update_ticket",
      "to": "decide_severity",
      "when": null
    },
    {
      "from": "decide_severity",
      "to": "branch_p1",
      "when": "P1"
    },
    {
      "from": "branch_p1",
      "to": "end_p1",
      "when": null
    },
    {
      "from": "decide_severity",
      "to": "branch_standard",
      "when": "Standard"
    },
    {
      "from": "branch_standard",
      "to": "end_standard",
      "when": null
    }
  ]
}
