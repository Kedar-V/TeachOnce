{
  "id": "WF-warranty_0011",
  "name": "Warranty resolution (expired)",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "a0_lookup_customer",
      "type": "ACTION",
      "label": "Lookup Customer",
      "tool": "crm",
      "op": "LOOKUP_CUSTOMER",
      "inputs": {
        "query": {
          "ref": "$case.query"
        }
      }
    },
    {
      "id": "a1_get_ticket",
      "type": "ACTION",
      "label": "Get Ticket",
      "tool": "crm",
      "op": "GET_TICKET",
      "inputs": {
        "ticket_id": {
          "ref": "$case.ticket_id"
        }
      }
    },
    {
      "id": "a2_get_device",
      "type": "ACTION",
      "label": "Get Device",
      "tool": "device",
      "op": "GET_DEVICE",
      "inputs": {
        "device_id": {
          "ref": "$case.device_id"
        }
      }
    },
    {
      "id": "a3_check_warranty",
      "type": "ACTION",
      "label": "Check Warranty",
      "tool": "warranty",
      "op": "CHECK_WARRANTY",
      "inputs": {
        "device_id": {
          "ref": "$case.device_id"
        }
      }
    },
    {
      "id": "a4_get_diagnostics",
      "type": "ACTION",
      "label": "Get Diagnostics",
      "tool": "diagnostics",
      "op": "GET_DIAGNOSTICS",
      "inputs": {
        "device_id": {
          "ref": "$case.device_id"
        }
      }
    },
    {
      "id": "a5_update_ticket",
      "type": "ACTION",
      "label": "Update Ticket",
      "tool": "crm",
      "op": "UPDATE_TICKET",
      "inputs": {
        "ticket_id": {
          "ref": "$case.ticket_id"
        }
      }
    },
    {
      "id": "decide_warranty",
      "type": "DECISION",
      "label": "Warranty status",
      "branches": [
        {
          "name": "Active"
        },
        {
          "name": "Expired"
        }
      ]
    },
    {
      "id": "branch_active",
      "type": "ACTION",
      "label": "Create Repair",
      "tool": "repair",
      "op": "CREATE_REPAIR",
      "inputs": {
        "device_id": {
          "ref": "$case.device_id"
        },
        "ticket_id": {
          "ref": "$case.ticket_id"
        }
      }
    },
    {
      "id": "end_active",
      "type": "END",
      "outcome": "SUCCEEDED"
    },
    {
      "id": "branch_expired",
      "type": "ACTION",
      "label": "Record Paid Options",
      "tool": "repair",
      "op": "RECORD_PAID_OPTIONS",
      "inputs": {
        "device_id": {
          "ref": "$case.device_id"
        },
        "ticket_id": {
          "ref": "$case.ticket_id"
        }
      }
    },
    {
      "id": "end_expired",
      "type": "END",
      "outcome": "SUCCEEDED"
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "a0_lookup_customer",
      "when": null
    },
    {
      "from": "a0_lookup_customer",
      "to": "a1_get_ticket",
      "when": null
    },
    {
      "from": "a1_get_ticket",
      "to": "a2_get_device",
      "when": null
    },
    {
      "from": "a2_get_device",
      "to": "a3_check_warranty",
      "when": null
    },
    {
      "from": "a3_check_warranty",
      "to": "a4_get_diagnostics",
      "when": null
    },
    {
      "from": "a4_get_diagnostics",
      "to": "a5_update_ticket",
      "when": null
    },
    {
      "from": "a5_update_ticket",
      "to": "decide_warranty",
      "when": null
    },
    {
      "from": "decide_warranty",
      "to": "branch_active",
      "when": "Active"
    },
    {
      "from": "branch_active",
      "to": "end_active",
      "when": null
    },
    {
      "from": "decide_warranty",
      "to": "branch_expired",
      "when": "Expired"
    },
    {
      "from": "branch_expired",
      "to": "end_expired",
      "when": null
    }
  ]
}
